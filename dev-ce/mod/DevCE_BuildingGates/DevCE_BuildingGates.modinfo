<?xml version="1.0" encoding="utf-8"?>
<Mod id="f3a99534-1fa3-46cc-83fe-790b25523903" version="1">
	<Properties>
		<Name>Dev CE Building Gates (experimental)</Name>
		<Teaser>Buildings and wonders a city can only build while one of its properties is set; progress is kept (needs Dev CE).</Teaser>
		<Description>EXPERIMENTAL, SINGLE PLAYER ONLY. Adds the table DevCE_BuildingGates (BuildingType, Property, Description): the building or wonder can only be built in a city whose property Property is 1 or more (MODIFIER_SINGLE_CITY_ADJUST_PROPERTY, or EFFECT_ADJUST_CITY_PROPERTY with COLLECTION_PLAYER_CITIES). When the property drops, the building leaves the production queue but keeps its progress (and a wonder its partly built model); it is shown greyed out with Description as the reason until the property is back. Other mods insert rows in their own SQL; list this mod as a dependency so the table exists first. Needs the Dev CE GameCore mod.</Description>
		<Authors>Dev CE</Authors>
		<CompatibleVersions>2.0</CompatibleVersions>
		<AffectsSavedGames>1</AffectsSavedGames>
	</Properties>
	<Dependencies>
		<Mod id="4873eb62-8ccc-4574-b784-dda455e74e68" title="Expansion: Gathering Storm" />
	</Dependencies>
	<InGameActions>
		<UpdateDatabase id="DCBG_SQL">
			<Properties><LoadOrder>-100</LoadOrder></Properties>
			<File>Sql/DevCE_BuildingGates.sql</File>
		</UpdateDatabase>
		<UpdateText id="DCBG_Text">
			<File>Text/DevCE_BuildingGates_Text.sql</File>
		</UpdateText>
	</InGameActions>
	<Files>
		<File>Sql/DevCE_BuildingGates.sql</File>
		<File>Text/DevCE_BuildingGates_Text.sql</File>
	</Files>
</Mod>
