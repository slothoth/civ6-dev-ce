<?xml version="1.0" encoding="utf-8"?>
<Mod id="b6670422-e81e-41e3-a10f-ecafdc73127d" version="1">
	<Properties>
		<Name>Dev CE City Specialists (experimental)</Name>
		<Teaser>Tables for specialists worked in the city centre, with slots per type (needs Dev CE).</Teaser>
		<Description>EXPERIMENTAL. Adds the tables DevCE_Specialists and DevCE_Specialist_Yields and the GlobalParameter DEVCE_CITY_CENTER_SPECIALISTS (default 0 = the game's normal specialists). With the parameter set to 1, each city has slots per specialist type (city property DEVCE_SPECIALIST_SLOTS_&lt;SpecialistType&gt;, set by modifiers), and a citizen in a slot gives that type's yields; the game's auto-assign fills the slots together with tiles. Other mods add the rows and set the parameter in their own SQL; list this mod as a dependency so the tables exist first. Needs the Dev CE GameCore mod; without it the tables do nothing.</Description>
		<Authors>slothoth</Authors>
		<CompatibleVersions>2.0</CompatibleVersions>
		<AffectsSavedGames>1</AffectsSavedGames>
	</Properties>
	<Dependencies>
		<Mod id="4873eb62-8ccc-4574-b784-dda455e74e68" title="Expansion: Gathering Storm" />
	</Dependencies>
	<InGameActions>
		<UpdateDatabase id="DCCS_SQL">
			<File>Sql/DevCE_CitySpecialists.sql</File>
		</UpdateDatabase>
		<AddGameplayScripts id="DCCS_GP">
			<File>Scripts/DevCE_CitySpecialists_GP.lua</File>
		</AddGameplayScripts>
		<ImportFiles id="DCCS_TEXTURES">
			<File>Textures/DevCE_CitizenButton_Face.dds</File>
			<File>Textures/DevCE_CitizenButton_Rim.dds</File>
			<File>Textures/DevCE_CitizenButton_Face_32.dds</File>
			<File>Textures/DevCE_CitizenButton_Rim_32.dds</File>
			<File>Textures/DevCE_Padlock_16.dds</File>
		</ImportFiles>
		<AddUserInterfaces id="DCCS_UI">
			<Properties><Context>InGame</Context></Properties>
			<File>UI/DevCE_CitySpecialists.xml</File>
		</AddUserInterfaces>
	</InGameActions>
	<Files>
		<File>Sql/DevCE_CitySpecialists.sql</File>
		<File>Scripts/DevCE_CitySpecialists_GP.lua</File>
		<File>UI/DevCE_CitySpecialists.xml</File>
		<File>UI/DevCE_CitySpecialists.lua</File>
		<File>Textures/DevCE_CitizenButton_Face.dds</File>
		<File>Textures/DevCE_CitizenButton_Rim.dds</File>
		<File>Textures/DevCE_CitizenButton_Face_32.dds</File>
		<File>Textures/DevCE_CitizenButton_Rim_32.dds</File>
		<File>Textures/DevCE_Padlock_16.dds</File>
	</Files>
</Mod>
