<?xml version="1.0" encoding="utf-8"?>
<Mod id="6c744c35-3117-436b-a771-324b4888eeff" version="1">
	<Properties>
		<Name>Dev CE Unit Upgrade Rules (experimental)</Name>
		<Teaser>Minimum experience level per unit upgrade (needs Dev CE).</Teaser>
		<Description>EXPERIMENTAL. Adds the table DevCE_UnitUpgradeRequirements (Unit, UpgradeUnit, MinLevel): a unit needs at least that experience level (1 + promotions earned with experience) to upgrade from Unit to UpgradeUnit. Unique units that replace either one get the same rule unless they have a row of their own. Other mods insert rows in their own SQL; list this mod as a dependency so the table exists first. Needs the Dev CE GameCore mod, which also stops units upgrading into a unit type the player cannot build (MODIFIER_PLAYER_UNIT_BUILD_DISABLED: unit limits, bans) with or without this mod. Single player only.</Description>
		<Authors>Dev CE</Authors>
		<CompatibleVersions>2.0</CompatibleVersions>
		<AffectsSavedGames>1</AffectsSavedGames>
	</Properties>
	<Dependencies>
		<Mod id="4873eb62-8ccc-4574-b784-dda455e74e68" title="Expansion: Gathering Storm" />
	</Dependencies>
	<LocalizedText>
		<Text id="LOC_DEVCE_UPGRADE_NEEDS_LEVEL">
			<en_US>Needs level {1_Need} to upgrade (is level {2_Have}).</en_US>
		</Text>
		<Text id="LOC_DEVCE_UPGRADE_UNIT_UNAVAILABLE">
			<en_US>The upgraded unit is not available to you right now (unit limit reached or not allowed).</en_US>
		</Text>
	</LocalizedText>
	<InGameActions>
		<UpdateDatabase id="DCUU_SQL">
			<File>Sql/DevCE_UnitUpgrades.sql</File>
		</UpdateDatabase>
		<AddGameplayScripts id="DCUU_GP">
			<File>Scripts/DevCE_UnitUpgrades_GP.lua</File>
		</AddGameplayScripts>
	</InGameActions>
	<Files>
		<File>Sql/DevCE_UnitUpgrades.sql</File>
		<File>Scripts/DevCE_UnitUpgrades_GP.lua</File>
	</Files>
</Mod>
